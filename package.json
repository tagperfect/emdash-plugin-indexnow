{
	"name": "@tagperfect/emdash-plugin-indexnow",
	"version": "1.2.2",
	"description": "Notifies Bing, Yandex, Seznam, Naver and other IndexNow engines when EmDash content is published, changed, unpublished or deleted.",
	"type": "module",
	"license": "MIT",
	"author": "Tag Perfect OÜ <npm@tagperfect.eu>",
	"homepage": "https://tagperfect.eu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tagperfect/emdash-plugin-indexnow.git"
	},
	"bugs": {
		"url": "https://github.com/tagperfect/emdash-plugin-indexnow/issues"
	},
	"keywords": [
		"emdash",
		"emdash-plugin",
		"indexnow",
		"seo",
		"bing",
		"yandex",
		"astro",
		"cloudflare",
		"search-engine"
	],
	"packageManager": "pnpm@10.34.7",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist/index.mjs",
		"dist/index.d.mts",
		"dist/plugin.mjs",
		"dist/plugin.d.mts",
		"dist/manifest.json",
		"emdash-plugin.jsonc",
		"icon.svg",
		"LICENSE",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish:registry": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"emdash": ">=1.0.1 <2"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "1.3.1",
		"@emdash-cms/plugin-cli": "0.13.4",
		"@emdash-cms/plugin-test": "0.2.10",
		"emdash": "1.3.1",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	}
}
